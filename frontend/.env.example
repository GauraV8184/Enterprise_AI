# =============================================================================
# Enterprise AI Intelligence Platform - frontend environment template
# -----------------------------------------------------------------------------
# Copy this file to `frontend/.env.local` (git-ignored) and fill in values.
# Only variables prefixed with VITE_ are exposed to browser code.
#
# NEVER put SUPABASE_SERVICE_ROLE_KEY or any LLM API key here. The browser must
# only ever receive the Supabase anon key, which is protected by RLS.
# =============================================================================

# Base URL of the backend API.
#   /api                 -> dev proxy (vite.config.ts) or a same-origin deploy
#   http://host:8000/api -> a backend on another origin
VITE_API_BASE_URL=/api

# --- Supabase Auth -----------------------------------------------------------
# Set BOTH values to sign in through Supabase Auth. Leave both empty to use the
# development X-User-Id identity stub. The backend must also allow the stub
# (ENVIRONMENT=development/test and AUTH_BACKEND=dev or no Supabase configured).
#
# Dashboard -> Project Settings -> API. The anon key is public by design.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Development identity ----------------------------------------------------
# Used only when the Supabase values above are empty. This is not a security
# control; it exists to exercise the API locally. The backend must be running
# with AUTH_BACKEND=dev and a local store/storage backend.
VITE_DEV_USER_ID=dev-user

# --- Upload hint -------------------------------------------------------------
# Keep this in step with the backend's MAX_UPLOAD_MB. It is a client-side
# pre-flight check only; the backend enforces the real limit.
VITE_MAX_UPLOAD_MB=25
