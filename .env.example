# =============================================================================
# Enterprise AI Intelligence Platform - environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env` in the repository root and fill in real values.
# NEVER commit `.env` - it is git-ignored.
#
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# Every variable below is read by the backend through `app/core/config.py`.
# Settings for later phases (Supabase, search) are added as each phase lands, so
# this file never advertises settings the code does not use.
# =============================================================================

# --- Application -------------------------------------------------------------
# One of: development | staging | production | test
ENVIRONMENT=development
DEBUG=false
APP_NAME=Enterprise AI Intelligence Platform
APP_VERSION=0.1.0
API_PREFIX=/api

# --- Logging -----------------------------------------------------------------
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Emit structured JSON logs (true) or human-readable logs (false).
LOG_JSON=true

# --- CORS --------------------------------------------------------------------
# Comma-separated browser origins (the Vite dev server default), or a JSON array.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM provider (Phase 2) --------------------------------------------------
# Supported values:
#   openai  - a hosted OpenAI account, or any OpenAI-compatible endpoint
#             (LiteLLM, vLLM, Azure proxy, ...) via OPENAI_BASE_URL
#   ollama  - a local Ollama server. No API key needed; defaults to
#             http://127.0.0.1:11434/v1
LLM_PROVIDER=openai

# ---------------------------------------------------------------------------
# OPTION A - a hosted OpenAI account
# ---------------------------------------------------------------------------
# Leave blank to run without an LLM. The chat endpoints then return HTTP 503
# with an actionable message instead of pretending to answer.
# Verify a new key with:  python scripts/check_llm.py
OPENAI_API_KEY=

# Any model your key can access. Model names change over time, so this is
# configurable on purpose. Verify availability with scripts/check_llm.py.
OPENAI_MODEL=gpt-4o-mini

# Optional: point at an OpenAI-compatible gateway instead of api.openai.com.
# OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# OPTION B - a local Ollama server (no account, no cost)
# ---------------------------------------------------------------------------
# 1. Install and start Ollama:            https://ollama.com
# 2. Pull a model with tool-calling support (needed from Phase 5 onward):
#        ollama pull llama3.1:8b
# 3. Set the two values below, then run:  python scripts/check_llm.py
#
# example:
#   LLM_PROVIDER=ollama
#   OPENAI_MODEL=llama3.1:8b
#
# OPENAI_API_KEY is not needed. If your Ollama server is not on localhost, set
# OPENAI_BASE_URL (for example http://192.168.1.9:11434/v1).

# Sampling temperature for chat requests (0.0 - 2.0).
LLM_TEMPERATURE=0

# Optional hard cap on generated tokens per request.
# LLM_MAX_TOKENS=

# Per-request timeout in seconds, and how many times to retry transient errors.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Embeddings (Phase 3) ----------------------------------------------------
# Embeddings are configured separately from the chat model, so a local embedding
# model can run alongside a hosted chat model (or the other way round).
#
#   ollama  - a local Ollama server. No API key.
#   openai  - a hosted OpenAI account, or an OpenAI-compatible endpoint.
EMBEDDING_PROVIDER=ollama

# For EMBEDDING_PROVIDER=ollama you must pull the model first:
#     ollama pull nomic-embed-text
# Changing this after documents are indexed invalidates their vectors - the API
# then refuses to search (409 embedding_dimension_mismatch) rather than returning
# meaningless results. Re-upload the documents after a change.
EMBEDDING_MODEL=nomic-embed-text

# Texts sent per embedding request.
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=120

# Optional: only needed when embeddings live on a different server than the chat
# model. Left unset, it follows EMBEDDING_PROVIDER's default.
# EMBEDDING_BASE_URL=http://192.168.1.50:11434/v1

# --- Document storage (Phase 3) ----------------------------------------------
# Where uploads and the development document store live. Relative paths are
# resolved against the repository root.
DATA_DIR=data

# Largest accepted upload, in megabytes. The file is read at most limit+1 bytes,
# so an oversized upload cannot exhaust memory before it is rejected.
MAX_UPLOAD_MB=25

# --- Retrieval (Phase 3) -----------------------------------------------------
# Characters per chunk, and how many characters consecutive chunks share. Overlap
# keeps a sentence that straddles a boundary findable. Must be smaller than
# CHUNK_SIZE or startup fails with an explanation.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Passages retrieved per question, and the total character budget for the context
# handed to the model. Raise TOP_K for recall, lower it to reduce prompt size.
RETRIEVAL_TOP_K=6
MAX_CONTEXT_CHARS=12000

# --- Supabase (Phase 4) ------------------------------------------------------
# Leave SUPABASE_URL blank to keep running entirely locally on the SQLite store
# from Phase 3. Filling it in switches the storage backend over, and from that
# point tenant isolation is enforced by Postgres Row Level Security instead of by
# Python.
#
# Verify the whole setup with:  python scripts/check_supabase.py
# SUPABASE_URL=https://<project-ref>.supabase.co

# API keys: Dashboard -> Project Settings -> API.
#
# The anon key is public by design. Every request made with it is still subject to
# Row Level Security, so it is safe for a browser to hold.
# SUPABASE_ANON_KEY=

# Privileged key. BYPASSES ROW LEVEL SECURITY COMPLETELY.
# Only admin scripts use this. It must never reach a browser: handing it out is
# equivalent to publishing the whole database.
# SUPABASE_SERVICE_ROLE_KEY=

# Full Postgres connection string, used ONLY by scripts/apply_migrations.py - the
# application itself always goes through PostgREST. Get it from
# Dashboard -> Connect -> Session pooler. Use the pooler host: the direct
# db.<ref>.supabase.co host is IPv6-only on current projects.
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Private bucket holding the original uploads, keyed
# <owner_id>/<document_id>/<filename>. Created by the migrations. Its own size
# limit should be kept in step with MAX_UPLOAD_MB below.
SUPABASE_DOCUMENTS_BUCKET=documents

# Which store holds documents and vectors.
#   auto     - Supabase when configured, otherwise the local SQLite store
#   sqlite   - always the local development store
#   supabase - always Supabase; refuses to start if it is not configured
DOCUMENT_STORE=auto

# Where a caller's identity comes from.
#   auto     - Supabase Auth when configured, otherwise the development stub
#   dev      - always the development stub (never allowed in production)
#   supabase - always Supabase Auth; refuses to start if it is not configured
AUTH_BACKEND=auto

# These two must agree. A Supabase store sends the caller's access token on
# every query and lets RLS decide what it can see; the development stub has no
# token to send. DOCUMENT_STORE=supabase with AUTH_BACKEND=dev is therefore
# refused at startup, rather than silently returning empty results. To use the
# stub, set DOCUMENT_STORE=sqlite as well.

# --- Development identity (Phase 3 fallback) ---------------------------------
# Used only when Supabase is not configured, or when AUTH_BACKEND=dev. Callers may
# then name themselves with the X-User-Id header; without it this id is used.
#
# This is NOT a security control: anyone can send that header. It exists so that
# ownership is enforced in the data layer from the very first endpoint, which is
# the part Phase 4 does not have to change. Once Supabase is configured it is
# bypassed entirely, and in ENVIRONMENT=production the API refuses to start
# without Supabase rather than trusting an unverified header.
DEV_USER_ID=dev-user
