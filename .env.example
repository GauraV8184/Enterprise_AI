# =============================================================================
# Enterprise AI Intelligence Platform - environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env` in the repository root and fill in real values.
# NEVER commit `.env` - it is git-ignored.
#
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# Every variable below is read by the backend through `app/core/config.py`.
# Settings for later phases (Supabase, search) are added as each phase lands, so
# this file never advertises settings the code does not use.
# =============================================================================

# --- Application -------------------------------------------------------------
# One of: development | staging | production | test
ENVIRONMENT=development
DEBUG=false
APP_NAME=Enterprise AI Intelligence Platform
APP_VERSION=0.1.0
API_PREFIX=/api

# --- Logging -----------------------------------------------------------------
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Emit structured JSON logs (true) or human-readable logs (false).
LOG_JSON=true

# --- CORS --------------------------------------------------------------------
# Comma-separated browser origins (the Vite dev server default), or a JSON array.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM provider (Phase 2) --------------------------------------------------
# Which provider client to build. Only "openai" is implemented today.
LLM_PROVIDER=openai

# Leave blank to run without an LLM. The chat endpoints then return HTTP 503
# with an actionable message instead of pretending to answer.
# Verify a new key with:  python scripts/check_llm.py
OPENAI_API_KEY=

# Any model your key can access. Model names change over time, so this is
# configurable on purpose. Verify availability with scripts/check_llm.py.
OPENAI_MODEL=gpt-4o-mini

# Optional: point at an OpenAI-compatible gateway (Azure proxy, LiteLLM, local
# vLLM, ...) instead of api.openai.com.
# OPENAI_BASE_URL=

# Sampling temperature for chat requests (0.0 - 2.0).
LLM_TEMPERATURE=0

# Optional hard cap on generated tokens per request.
# LLM_MAX_TOKENS=

# Per-request timeout in seconds, and how many times to retry transient errors.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
