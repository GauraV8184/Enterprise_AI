# =============================================================================
# Enterprise AI Intelligence Platform - environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.  NEVER commit `.env`.
#
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# Every variable below is read by the backend through `app/core/config.py`.
# Variables for later phases (LLM, Supabase, search) are added as each phase is
# implemented so this file never advertises settings the code does not use.
# =============================================================================

# --- Application -------------------------------------------------------------
# One of: development | staging | production | test
ENVIRONMENT=development
DEBUG=false
APP_NAME=Enterprise AI Intelligence Platform
APP_VERSION=0.1.0
API_PREFIX=/api

# --- Logging -----------------------------------------------------------------
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Emit structured JSON logs (true) or human-readable logs (false).
LOG_JSON=true

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed browser origins (the Vite dev server default).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
